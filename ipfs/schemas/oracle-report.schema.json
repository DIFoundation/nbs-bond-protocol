{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project_id",
    "provider",
    "methodology",
    "period_start",
    "period_end",
    "carbon_sequestered",
    "ipfs_evidence_hash"
  ],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "methodology": {
      "type": "string",
      "enum": ["VERRA-VCS", "GOLD-STANDARD", "ACR", "CAR", "REMOTE-SENSING", "IOT-SENSORS"]
    },
    "period_start": { "type": "string", "format": "date" },
    "period_end": { "type": "string", "format": "date" },
    "carbon_sequestered": { "type": "number", "minimum": 0 },
    "ipfs_evidence_hash": { "type": "string", "pattern": "^Qm[1-9A-HJ-NP-Za-km-z]+$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "object" }
  }
}
